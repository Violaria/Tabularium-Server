{
  "name": "@tabularium/server",
  "version": "0.25.0",
  "author": "Hanae Nanako",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.ui.json && node build-ui.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test test/browser.e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/ssh2": "1.15.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "diff": "9.0.0",
    "octagonal-wheels": "0.1.55",
    "openai": "7.45.1",
    "pdfjs-dist": "6.4.299",
    "re2js": "2.8.6",
    "ssh2": "1.17.0"
  }
}
