{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "noEmit": true,
    },
    "include": ["**/*.ts", "**/*.svelte"],
    "exclude": ["**/*.unit.spec.ts"]
}
